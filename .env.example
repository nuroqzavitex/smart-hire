# Local development settings for deploy/docker (make bootstrap copies this to
# .env when .env does not exist). Never use these values outside a local machine.

# Postgres superuser password (used only by the image's init scripts).
POSTGRES_PASSWORD=postgres-dev-only

# Password of the auth_svc role that owns auth_db. It is embedded in a DSN, so
# avoid URL-reserved characters (@ : / ? # %).
AUTH_DB_PASSWORD=auth-dev-only

# Password of the job_svc role that owns job_db (same URL-character caveat).
JOB_DB_PASSWORD=job-dev-only

# Password of the candidate_svc role that owns candidate_db (same caveat).
CANDIDATE_DB_PASSWORD=candidate-dev-only

# Password of the ai_svc role that owns ai_db (same caveat).
AI_DB_PASSWORD=ai-dev-only

# Password of the application_svc role that owns application_db (same caveat).
APPLICATION_DB_PASSWORD=application-dev-only

# Password of the notification_svc role that owns notification_db (same caveat).
NOTIFICATION_DB_PASSWORD=notification-dev-only

# MinIO root credentials, used only by the minio-init container and tests.
# MinIO requires the password to be at least 8 characters.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=minio-root-dev-only

# MinIO user of the candidate service (put/get/delete on cvs/*), created by
# minio-init. The secret must be at least 8 characters.
CANDIDATE_S3_ACCESS_KEY=candidate-svc
CANDIDATE_S3_SECRET_KEY=candidate-dev-only

# MinIO user of the AI service (get on cvs/* only), created by minio-init.
# The secret must be at least 8 characters.
AI_S3_ACCESS_KEY=ai-svc
AI_S3_SECRET_KEY=ai-dev-only

# AI CV parser: fake = rule-based, no network (default for dev/CI/smoke). Set
# AI_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY=... to use real Claude; never
# commit a key.
AI_LLM_PROVIDER=fake

# CV/job embeddings for matching (ADR 0010): fake = hashed bag of words, no
# network (default for dev/CI/smoke). Set AI_EMBEDDING_PROVIDER=gemini and
# AI_GEMINI_API_KEY=... (Gemini API free tier) for real embeddings; never commit
# a key. Changing the provider writes to new Qdrant collections, so existing
# CVs/jobs need a re-run (reparse, edit or re-publish) to be matched again.
AI_EMBEDDING_PROVIDER=fake
# AI_GEMINI_API_KEY=
# AI_EMBEDDING_MODEL=gemini-embedding-001

# Admin user created by make seed.
SEED_ADMIN_EMAIL=admin@smarthire.local
SEED_ADMIN_PASSWORD=Admin-Password-123!
