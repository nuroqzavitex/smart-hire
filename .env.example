# Local development settings for deploy/docker (make bootstrap copies this to
# .env when .env does not exist). Never use these values outside a local machine.

# Postgres superuser password (used only by the image's init scripts).
POSTGRES_PASSWORD=postgres-dev-only

# Password of the auth_svc role that owns auth_db. It is embedded in a DSN, so
# avoid URL-reserved characters (@ : / ? # %).
AUTH_DB_PASSWORD=auth-dev-only

# Password of the job_svc role that owns job_db (same URL-character caveat).
JOB_DB_PASSWORD=job-dev-only

# Admin user created by make seed.
SEED_ADMIN_EMAIL=admin@smarthire.local
SEED_ADMIN_PASSWORD=Admin-Password-123!
