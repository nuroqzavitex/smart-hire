    {
      "name": "AIService",
      "description": "AIService is internal to the compose network (no JWT, ADR 0010): Job and\nCandidate check ownership before calling it."
    },
    {
      "name": "ApplicationService",
      "description": "ApplicationService: candidates apply to open jobs; an orchestration saga\nreserves quota and scores the application in the background (ADR 0011)."
    },
