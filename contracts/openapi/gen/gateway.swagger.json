      "name": "AuthService"
    },
    {
      "name": "CandidateService"
    },
    {
      "name": "JobService"
    },
    {
      "name": "NotificationService",
      "description": "NotificationService lists the caller's notifications (ADR 0012). New ones\nare also pushed over the gateway WebSocket (/v1/ws)."
    }
  ],
