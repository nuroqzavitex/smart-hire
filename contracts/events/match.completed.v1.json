{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarthire.local/events/match.completed.v1.json",
  "title": "match.completed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "source",
    "occurred_at",
    "trace_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_type": {
      "const": "match.completed"
    },
    "event_version": {
      "const": 1
    },
    "source": {
      "const": "ai-service"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "model_version",
        "top"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "top": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "cv_id",
              "score"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "format": "uuid"
              },
              "cv_id": {
                "type": "string",
                "format": "uuid"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
