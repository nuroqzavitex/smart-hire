{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarthire.local/events/cv.parse_failed.v1.json",
  "title": "cv.parse_failed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "source", "occurred_at", "trace_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_type": { "const": "cv.parse_failed" },
    "event_version": { "const": 1 },
    "source": { "const": "ai-service" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cv_id", "candidate_id", "attempt_id", "reason", "detail"],
      "properties": {
        "cv_id": { "type": "string", "format": "uuid" },
        "candidate_id": { "type": "string", "format": "uuid" },
        "attempt_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "reason": { "enum": ["no_text", "not_pdf", "too_large", "llm_refused", "llm_invalid_output", "download_failed"] },
        "detail": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
