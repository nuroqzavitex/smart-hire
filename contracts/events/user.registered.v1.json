{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarthire.local/events/user.registered.v1.json",
  "title": "user.registered v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "source", "occurred_at", "trace_id", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "event_type": { "const": "user.registered" },
    "event_version": { "const": 1 },
    "source": { "const": "auth-service" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "email", "role"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "email": { "type": "string" },
        "role": { "enum": ["candidate", "recruiter", "admin"] }
      }
    }
  }
}
